{
  "name": "shabitools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:simple": "playwright test tests/simple-check.spec.ts",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome'",
    "test:report": "playwright show-report",
    "deploy": "pnpm build && wrangler pages deploy out --branch main",
    "deploy:preview": "pnpm build && wrangler pages deploy out --branch preview",
    "deploy:production": "pnpm build && wrangler pages deploy out --branch main",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:deploy": "pnpm build && wrangler pages deploy out"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "marked": "^17.0.1",
    "next": "^14.2.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "wrangler": "^3.0.0"
  }
}
