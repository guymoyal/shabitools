# Admitad official API (CPA deeplinks)
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_BASE64_HEADER=
ADMITAD_API_URL=https://api.admitad.com
ADMITAD_WEBSITE_ID=        # shabitools ad-space id from the Admitad dashboard
ADMITAD_VERIFY_CODE=
NEXT_PUBLIC_SITE_URL=https://shabitools.com
# Google AdSense — one responsive Display ad-unit slot id (Ads → By ad unit → Display)
# drives every in-content ad slot. Leave empty to render no ads.
NEXT_PUBLIC_ADSENSE_SLOT=
# Amazon Associates store id (e.g. shabitools-20). Tags every Amazon productUrl
# at build time. Leave empty to hide Amazon affiliate buttons entirely.
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=
# Admitad internal-catalog harvest (CPC partner programs)
HARVEST_WEBSITE_ID=        # same ad-space id
HARVEST_CATEGORIES=        # comma-separated catalog category ids (home improvement / DIY / garden)
# Landing copy generation
DEEPSEEK_API_KEY=
# pexels.com/api — image pipeline (pnpm images:fetch)
PEXELS_API_KEY=
# --- Advisor feature (server-side only; set as Cloudflare Pages secrets) ---
# Product source: 'live' calls Amazon PA-API; anything else (or unset) uses the
# offline curated catalog in content/advisor-seed.json. Keep on seed until PA-API
# calls actually succeed (keys can exist but return AssociateNotEligible). See
# docs/advisor-go-live.md.
ADVISOR_SOURCE=seed
# Amazon PA-API 5.0 credentials. Requires an approved Associates account AND
# 10 qualifying sales in the trailing 30 days before Amazon enables the API.
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
# Server copy of the Associates tag (same value as NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG)
AMAZON_ASSOCIATES_TAG=
