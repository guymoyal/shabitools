{
  "examples": [
    {
      "name": "Email Validation",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "testString": "user@example.com",
      "flags": [],
      "description": "Validates email format"
    },
    {
      "name": "URL Extraction",
      "pattern": "https?://[^\\s]+",
      "testString": "Visit https://example.com for more info",
      "flags": ["g"],
      "description": "Extracts URLs from text"
    },
    {
      "name": "Phone Number",
      "pattern": "^\\+?[\\d\\s\\-\\(\\)]+$",
      "testString": "+1 (555) 123-4567",
      "flags": [],
      "description": "Matches phone number format"
    },
    {
      "name": "Credit Card",
      "pattern": "\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}",
      "testString": "1234-5678-9012-3456",
      "flags": [],
      "description": "Matches credit card format"
    },
    {
      "name": "IP Address",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "testString": "192.168.1.1",
      "flags": [],
      "description": "Matches IPv4 addresses"
    },
    {
      "name": "Date Format",
      "pattern": "\\d{4}-\\d{2}-\\d{2}",
      "testString": "2024-12-25",
      "flags": [],
      "description": "Matches YYYY-MM-DD date format"
    }
  ]
}
