{
  "patterns": [
    {
      "name": "Email Validation",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "description": "Validates email format",
      "category": "Validation",
      "example": "user@example.com",
      "flags": []
    },
    {
      "name": "URL Extraction",
      "pattern": "https?://[^\\s]+",
      "description": "Extracts URLs from text",
      "category": "Extraction",
      "example": "Visit https://example.com",
      "flags": ["g"]
    },
    {
      "name": "Phone Number",
      "pattern": "^\\+?[\\d\\s\\-\\(\\)]+$",
      "description": "Matches phone number format",
      "category": "Validation",
      "example": "+1 (555) 123-4567",
      "flags": []
    },
    {
      "name": "Credit Card",
      "pattern": "\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}",
      "description": "Matches credit card format",
      "category": "Validation",
      "example": "1234-5678-9012-3456",
      "flags": []
    },
    {
      "name": "IP Address",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "description": "Matches IPv4 addresses",
      "category": "Extraction",
      "example": "192.168.1.1",
      "flags": []
    },
    {
      "name": "Date (YYYY-MM-DD)",
      "pattern": "\\d{4}-\\d{2}-\\d{2}",
      "description": "Matches YYYY-MM-DD date format",
      "category": "Validation",
      "example": "2024-12-25",
      "flags": []
    },
    {
      "name": "Time (HH:MM)",
      "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Matches 24-hour time format",
      "category": "Validation",
      "example": "14:30",
      "flags": []
    },
    {
      "name": "Hex Color",
      "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
      "description": "Matches hex color codes",
      "category": "Validation",
      "example": "#FF5733",
      "flags": []
    },
    {
      "name": "Alphanumeric",
      "pattern": "^[a-zA-Z0-9]+$",
      "description": "Matches alphanumeric strings only",
      "category": "Validation",
      "example": "abc123",
      "flags": []
    },
    {
      "name": "Whitespace Removal",
      "pattern": "\\s+",
      "description": "Matches whitespace (for removal)",
      "category": "Extraction",
      "example": "hello   world",
      "flags": ["g"]
    }
  ]
}
