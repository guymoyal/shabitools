# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Google PageSpeed Insights API Key
# Get your API key from: https://developers.google.com/speed/docs/insights/v5/get-started
# Required for Page Speed Compare tool
# Note: This tool requires a valid API key to function
NEXT_PUBLIC_PAGESPEED_API_KEY=your_pagespeed_api_key_here

# DeepSeek API Key (for text/chat only, NOT for image generation)
# Get your API key from: https://platform.deepseek.com/
# Note: DeepSeek API does not support image generation endpoints
# This key is for text/chat completions only
# Currently not used by any tools, reserved for future features
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Note: All other tools work without API keys - they run entirely client-side
# For image/logo generation, use free options or your own API keys:
# - Free: Hugging Face Spaces, Craiyon, Leonardo.ai free tier
# - Paid: OpenAI DALL-E, Midjourney, Stability AI (users provide their own keys)
# See .ai-rules/image-creator.md for details
